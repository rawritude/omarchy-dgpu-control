<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>dGPU Control</vendor>
  <vendor_url>https://github.com/rawritude/omarchy-dgpu-control</vendor_url>

  <!--
    Without this file pkexec still runs the helper, but under the generic
    org.freedesktop.policykit.exec action, whose prompt says only that a
    program wants to run as another user. Naming the action lets the dialog
    say what is actually about to change.

    auth_admin_keep, not auth_admin: opening the gate is normally followed
    within the same sitting by adjusting the limits it unlocks, and a password
    prompt per slider would make the feature unusable.
  -->
  <action id="io.github.rawritude.dgpu-control.tuning">
    <description>Change the asusd power-limit tuning gate</description>
    <message>Authentication is required to let this profile carry its own power limits</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/asusd-tuning</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
